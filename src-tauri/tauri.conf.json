{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Les broderies de Mamie",
  "version": "1.0.0",
  "identifier": "fr.broderies-de-mamie.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Les broderies de Mamie",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Ranger, retrouver et voir ses broderies",
    "longDescription": "Bibliothèque de motifs de broderie machine (.pes, .vp3, .pv3) sans doublons, avec recherche et visualisation.",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      },
      "wix": { "language": "fr-FR" }
    }
  }
}
